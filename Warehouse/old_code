                            add_energy(x, y + 1, diffusion_value)   # 向下扩散
                            add_energy(x, y - 1, diffusion_value)   # 向上扩散
                            add_energy(x, y, 0 - diffusion_value * 3)  # 扩散后当前网格减少能量
                        else:
                            diffusion_value = energy.value / 4      # 实际的单个网格扩散量
                            add_energy(x + 1, y, diffusion_value)   # 向右扩散
                            add_energy(x, y + 1, diffusion_value)   # 向下扩散
